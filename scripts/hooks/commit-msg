#!/bin/sh
# Git commit-msg hook: reject messages that do not follow the convention.
# `make install` enables it with: git config core.hooksPath scripts/hooks
# Git runs hooks from the top of the working tree, so this path resolves.
py=.venv/bin/python
[ -x "$py" ] || py=python3
exec "$py" -m ai_engineer.foundations.commitmsg "$1"
